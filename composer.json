{
    "name": "kinetis/storage-s3",
    "description": "S3 (and S3-compatible) file storage for Kinetis, plugging into kinetis/storage's FILESYSTEM_DRIVER=s3 — every S3 call travels on a Revolt-native HTTP transport.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.5.0",
        "kinetis/storage": "^1.2.0",
        "kinetis/revolt-http-client": "^1.3.0",
        "async-aws/core": "^1.29.2",
        "async-aws/s3": "^3.4.1",
        "league/flysystem": "^3.35.2",
        "league/flysystem-async-aws-s3": "^3.31.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\StorageS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\StorageS3\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
